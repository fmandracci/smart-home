/*------------------------------------*/
/* Generic Stylesheet for Mect Panels */
/*------------------------------------*/
/*------------------------*/
/* Customizing QScrollBar */
/* For all Library Pages  */
/*------------------------*/
/* horizontal Scrollbar   */
/*------------------------*/
QScrollBar:horizontal {
    border: 2px solid grey;
    background: rgb(218, 231, 241);
    height: 25px;
    margin: 0px 30px 0 30px;
}
/* Pulsante di scorrimento orizziontale */
QScrollBar::handle:horizontal {
    background: SteelBlue;
    min-width: 40px;
}
/* Estremi Destri e sinistri della Scroll orizzontale */
QScrollBar::add-line:horizontal {
    border: 2px solid grey;
    background: LightSkyBlue;
    width: 30px;
    subcontrol-position: right;
    subcontrol-origin: margin;
}
QScrollBar::sub-line:horizontal {
    border: 2px solid grey;
    background: LightSkyBlue;
    width: 30px;
    subcontrol-position: left;
    subcontrol-origin: margin;
}
/* The left-arrow and right-arrow have a solid grey border with a white background. As an alternative, you could also embed the image of an arrow. */
QScrollBar:left-arrow:horizontal, QScrollBar::right-arrow:horizontal {
    border: 2px solid grey;
    width: 6px;
    height: 6px;
    background: white;
}
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}
/*------------------------*/
/* Vertical   Scrollbar   */
/*------------------------*/
QScrollBar:vertical {
     border: 2px solid grey;
     background: SteelBlue;
     width: 25px;
     margin: 27px 0 27px 0;
}
/* Pulsante di scorrimento verticale */
QScrollBar::handle:vertical {
     background: Azure;
     min-height: 40px;
}
/* Estremi Sopra e Sotto della Scroll verticale */
QScrollBar::add-line:vertical {
     border: 2px solid grey;
     background: LightSkyBlue;
     height: 30px;
     subcontrol-position: bottom;
     subcontrol-origin: margin;
}

QScrollBar::sub-line:vertical {
     border: 2px solid grey;
     background: LightSkyBlue;
     height: 30px;
     subcontrol-position: top;
     subcontrol-origin: margin;
}
QScrollBar::up-arrow:vertical, QScrollBar::down-arrow:vertical {
     border: 2px solid grey;
     width: 6px;
     height: 6px;
     background: white;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
     background: none;
}
/* System Pages Background */
QDialog#item_selector, 
QDialog#qrcode, 
page#alarms, 
page#alarms_history, 
page#data_manager, 
page#display_settings, 
page#info,  
page#login_pwd, 
page#menu, 
page#net_conf, 
page#options, 
page#recipe, 
page#recipe_select, 
page#set_password, 
page#store, 
page#store_filter, 
page#system_ini, 
page#time_set, 
page#trend, 
page#trend_other, 
page#trend_range {
        background-color: rgb(32, 32, 32);
}
/* System Pages QLabel Font, Background and Color */
QDialog#item_selector QLabel, 
QDialog#qrcode        QLabel, 
page#alarms           QLabel, 
page#alarms_history   QLabel, 
page#data_manager     QLabel, 
page#display_settings QLabel, 
page#info             QLabel, 
page#login_pwd        QLabel, 
page#menu             QLabel, 
page#options          QLabel, 
page#recipe           QLabel, 
page#recipe_select    QLabel, 
page#set_password     QLabel, 
page#store            QLabel, 
page#store_filter     QLabel, 
page#time_set         QLabel, 
page#trend            QLabel, 
page#trend_range      QLabel  {
        background-color: rgb(32, 32, 32);
        color: rgb(255, 237, 0);
}
/* System Pages QPushButton Background and Color */
QDialog#item_selector QPushButton, 
QDialog#qrcode        QPushButton, 
page#alarms           QPushButton, 
page#alarms_history   QPushButton, 
page#data_manager     QPushButton, 
page#display_settings QPushButton, 
page#info             QPushButton, 
page#login_pwd        QPushButton, 
page#menu             QPushButton, 
page#net_conf         QPushButton, 
page#options          QPushButton, 
page#recipe           QPushButton, 
page#recipe_select    QPushButton, 
page#set_password     QPushButton, 
page#store            QPushButton, 
page#store_filter     QPushButton, 
page#system_ini       QPushButton, 
page#time_set         QPushButton, 
page#trend            QPushButton, 
page#trend_other      QPushButton, 
page#trend_range      QPushButton  {
        border: 1px solid  DarkGray;
        background-color: rgb(66,66,66);
        color: rgb(255, 237, 0);
        border-radius: 4px;
        qproperty-focusPolicy: NoFocus;
}
/* System Pages QPushButton Background and Color status:pressed */
QDialog#item_selector QPushButton:pressed, 
QDialog#qrcode        QPushButton:pressed, 
page#alarms           QPushButton:pressed, 
page#alarms_history   QPushButton:pressed, 
page#data_manager     QPushButton:pressed, 
page#display_settings QPushButton:pressed, 
page#info             QPushButton:pressed, 
page#login_pwd        QPushButton:pressed, 
page#menu             QPushButton:pressed, 
page#net_conf         QPushButton:pressed, 
page#options          QPushButton:pressed, 
page#recipe           QPushButton:pressed, 
page#recipe_select    QPushButton:pressed, 
page#set_password     QPushButton:pressed, 
page#store            QPushButton:pressed, 
page#store_filter     QPushButton:pressed, 
page#system_ini       QPushButton:pressed, 
page#time_set         QPushButton:pressed, 
page#trend            QPushButton:pressed, 
page#trend_other      QPushButton:pressed, 
page#trend_range      QPushButton:pressed  {
        border: 2px solid  rgb(194, 194, 194);
        color: rgb(70,70,80);
        background-color:  rgb(255, 255, 127);
}
/* System Pages QPushButton Background and Color  status:disabled */
QDialog#item_selector QPushButton:disabled, 
QDialog#qrcode        QPushButton:disabled, 
page#alarms           QPushButton:disabled, 
page#alarms_history   QPushButton:disabled, 
page#data_manager     QPushButton:disabled, 
page#display_settings QPushButton:disabled, 
page#info             QPushButton:disabled, 
page#login_pwd        QPushButton:disabled, 
page#menu             QPushButton:disabled, 
page#net_conf         QPushButton:disabled, 
page#options          QPushButton:disabled, 
page#recipe           QPushButton:disabled, 
page#recipe_select    QPushButton:disabled, 
page#set_password     QPushButton:disabled, 
page#store            QPushButton:disabled, 
page#store_filter     QPushButton:disabled, 
page#system_ini       QPushButton:disabled, 
page#time_set         QPushButton:disabled, 
page#trend            QPushButton:disabled, 
page#trend_other      QPushButton:disabled, 
page#trend_range      QPushButton:disabled  {
        border: 1px solid  DimGray;
        background-color: DarkGray;
        color: Silver;
}
/* QCheckBox && QLabel (net_conf, system_ini) */
page#net_conf         QCheckBox, 
page#net_conf         QLabel, 
page#system_ini       QCheckBox, 
page#system_ini       QLabel  {
        background-color: DimGray;
        color: rgb(255, 237, 0);
}
page#net_conf         QCheckBox::indicator,
page#system_ini       QCheckBox::indicator  {
        subcontrol-origin:border;
        Subcontrol-position:left Center;
}
page#net_conf         QCheckBox::indicator:checked,
page#system_ini       QCheckBox::indicator:checked  {
        image: url(:/libicons/img/Switch_On_yellow.png);
}
page#net_conf         QCheckBox::indicator:unchecked,
page#system_ini       QCheckBox::indicator:unchecked  {
        image: url(:/libicons/img/Switch_Off_yellow.png);
}
page#info             QTabBar::tab:!selected, 
page#net_conf         QTabBar::tab:!selected, 
page#system_ini       QTabBar::tab:!selected  {
        background: DarkGray;
        color: DarkGreen;
}
page#info             QTabBar::tab:!enabled, 
page#net_conf         QTabBar::tab:!enabled, 
page#system_ini       QTabBar::tab:!enabled  {
        background: LightGrey;
        color: DarkGray;
}
/* Info Page QPlainTextEdit */
page#info             QPlainTextEdit  {
        border: 1px solid rgb(60, 60, 60);  
        border-radius: 2px;
        background-color: DimGray;
        color: rgb(255, 237, 0);
}
/* QProgressBar in page0 (startup), recipe, time_set  */
page#page0            QProgressBar, 
page#recipe           QProgressBar, 
page#time_set         QProgressBar  {
        border: 2px solid         DeepSkyBlue;
        text-align: center;
        color: black;
}
page#page0            QProgressBar::chunk, 
page#recipe           QProgressBar::chunk, 
page#time_set         QProgressBar::chunk  {
        background-color: LightSkyBlue;
        margin: 1px;
}
/* Alarms QLineEdit */
page#alarms           QLineEdit  {
        background: rgb(50, 50, 50);
        color: Yellow;
}
/* QListWidget in alarms, alarms_history, recipe_select, item_selector */
/* QTableWidget in recipe, store  net_conf */
QDialog#item_selector QListWidget,
page#alarms           QListWidget, 
page#alarms_history   QListWidget, 
page#net_conf         QTableWidget, 
page#recipe           QTableWidget, 
page#recipe_select    QListWidget, 
page#store            QTableWidget  {
        background-color: SteelBlue;
        alternate-background-color: LightGrey;
        color: yellow;
        show-decoration-selected: 1;
        gridline-color:  LightSkyBlue;
}
QDialog#item_selector QListWidget::item:selected,
page#alarms           QListWidget::item:selected, 
page#alarms_history   QListWidget::item:selected, 
page#net_conf         QTableWidget::item:selected, 
page#recipe           QTableWidget::item:selected, 
page#recipe_select    QListWidget::item:selected, 
page#store            QTableWidget::item:selected  {
        border: 2px solid CadetBlue;
        background: red;
        color: yellow;
}
page#net_conf         QHeaderView::section, 
page#recipe           QHeaderView::section,
page#store            QHeaderView::section  {
        background-color: DarkCyan ;
        background: DimGray;
        color: yellow;
}
page#trend            QLabel, 
page#trend            QwtPlotCanvas  {
        background-color: DimGray;
        color: rgb(255, 237, 0);
}
page#alarms           QComboBox QAbstractItemView, 
page#alarms_history   QComboBox QAbstractItemView, 
page#net_conf         QComboBox QAbstractItemView, 
page#system_ini       QComboBox QAbstractItemView, 
page#time_set         QComboBox QAbstractItemView  {
        background-color: LightGray;
        color: MediumBlue;
}
/* alphanumpad and numpad common  settings */
QDialog#alphanumpad, 
QDialog#numpad  {
        background-color: rgb(32, 32, 32);
}
QDialog#alphanumpad   QMessageBox, 
QDialog#numpad        QMessageBox   {
        background-color: rgb(32, 32, 32);
        color: red;
}
QDialog#alphanumpad   QPushButton,
QDialog#numpad        QPushButton   {
        qproperty-focusPolicy: NoFocus;
        text-align: center;
        border-radius: 4px;
        border: 2px solid  LemonChiffon;
        background-repeat: no-repeat;
        background-position: center center;
        background-color: rgb(77, 77, 77);
        image-position: center center;
        color: LemonChiffon;
        background-clip: padding;
}
QDialog#alphanumpad   QPushButton:pressed,
QDialog#numpad        QPushButton:pressed   {
        border: 2px solid  rgb(194, 194, 194);
        background-color:  rgb(255, 255, 127);
        color: rgb(70,70,80);
}
QDialog#alphanumpad   QPushButton:disabled,
QDialog#numpad        QPushButton:disabled   {
        border: 1px solid  DimGray;
        background-color: DarkGray;
        color: Silver;
}
QDialog#alphanumpad   QPushButton#pushButtonPassword,
QDialog#numpad        QPushButton#pushButtonPassword  {
        qproperty-icon: url(:/libicons/img/Eye_invisible.png); 
}
QDialog#alphanumpad   QPushButton#pushButtonPassword:checked,
QDialog#numpad        QPushButton#pushButtonPassword:checked   {
        qproperty-icon: url(:/libicons/img/Eye_visible.png);
}
QDialog#alphanumpad   QLineEdit,
QDialog#numpad        QLineEdit   {
        border-radius: 1px;
        border: 1px solid  PaleTurquoise;
        background-color: DimGray;
        background-repeat: no-repeat;
        selection-background-color: DarkSlateGray;
        selection-color: Yellow;
}
QDialog#numpad        QLabel#labelMax,
QDialog#numpad        QLabel#labelMin,
QDialog#alphanumpad   QLabel#labelPrompt,
QDialog#numpad        QLabel#labelPrompt   {
        color: rgb(255, 237, 0);
}
/* Only for numpad */
QDialog#numpad        QLineEdit#lineEditVal   {
        text-align: center;
        color: LemonChiffon;
}
QDialog#numpad        QLineEdit#lineEditMax,
QDialog#numpad        QLineEdit#lineEditMin   {
        color: LawnGreen;
}
/* Only for alphanumpad */
QDialog#alphanumpad   QLineEdit   {
        color: Cornsilk;
}
QDialog#alphanumpad   QPushButton#pushButtonClear   {
        qproperty-icon: url(:/libicons/img/Clear.png); 
}
QDialog#alphanumpad   QPushButton#pushButtonEsc   {
        qproperty-icon: url(:/libicons/img/Cancel.png); 
}
QDialog#alphanumpad   QPushButton#pushButtonEnter   {
        qproperty-icon: url(:/libicons/img/Ok.png);
}
QDialog#alphanumpad   QPushButton#pushButtonBackspace   {
        qproperty-icon: url(:/libicons/img/Back.png);
}
QDialog#alphanumpad   QPushButton#pushButtonCapsLock   {
        background-origin: content;
        background-image: url(:/libicons/img/Chevron-up-double_60.png);
}
QDialog#alphanumpad   QPushButton#pushButtonCapsLock:checked   {
        background-image: url(:/libicons/img/Chevron-down-double_60.png);
}
/* QDialogButtonBox (Message Box Buttons) */
QDialogButtonBox { 
        dialogbuttonbox-buttons-have-icons: 1; 
        /* Icons for Dialog Buttons */
        dialog-apply-icon: url(":/systemicons/Apply_48.png");
        dialog-cancel-icon: url(":/systemicons/Cancel_48.png");
        dialog-close-icon: url(":/systemicons/Close_48.png");
        dialog-discard-icon: url(":/systemicons/Discard_48.png");
        dialog-help-icon: url(":/systemicons/Help_48.png");
        dialog-no-icon: url(":/systemicons/No_48.png");
        dialog-ok-icon: url(":/systemicons/Ok_48.png");
        dialog-open-icon: url(":/systemicons/Open_48.png");
        dialog-reset-icon: url(":/systemicons/Reset_48.png");
        dialog-save-icon: url(":/systemicons/Save_48.png");
        dialog-yes-icon: url(":/systemicons/Yes_48.png");
}
